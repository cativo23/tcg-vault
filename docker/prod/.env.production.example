APP_NAME=tcg-vault
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tcgvault.cativo.dev

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tcg_vault
DB_USERNAME=tcg_vault
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CLIENT=predis

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=tcgvault.cativo.dev
SESSION_LIFETIME=525600
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=public

LOG_CHANNEL=stderr
LOG_LEVEL=warning

TCGVAULT_ADMIN_USERNAME=cativo23
TCGVAULT_ADMIN_EMAIL=
TCGVAULT_ADMIN_PASSWORD=
# Where in-app feedback is emailed. Optional; defaults to TCGVAULT_ADMIN_EMAIL.
TCGVAULT_FEEDBACK_EMAIL=
TCGVAULT_ALLOW_REGISTRATION=false

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=tcgvault@cativo.dev
MAIL_FROM_NAME=tcg-vault

TCGDEX_BASE_URL=https://api.tcgdex.net/v2/en

# TCGplayer prices via tcgcsv.com. Must be https; the User-Agent identifies
# this app as tcgcsv's rules ask.
TCGCSV_BASE_URL=https://tcgcsv.com
TCGCSV_USER_AGENT="tcg-vault/1 (+https://tcgvault.cativo.dev)"
# fill: write tcgcsv's price for linked prints tcgdex doesn't price on
# TCGplayer. shadow: compare only, write nothing (the rollback).
TCGCSV_MODE=fill
# The daily tcgcsv run logs at info on its own channel, even when
# LOG_LEVEL is warning.
LOG_TCGCSV_LEVEL=info

# Only used if LOG_CHANNEL above is switched to daily; production logs to stderr.
LOG_DAILY_DAYS=14

SENTRY_LARAVEL_DSN=http://__BUGSINK_PROJECT_KEY__@bugsink:8000/1
SENTRY_ENVIRONMENT=production
